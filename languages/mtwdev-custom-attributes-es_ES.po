#. Description of the plugin
#: mtwdev-custom-attributes.php
msgid "Easily add custom HTML attributes (data-*, aria-*, boolean, and key-value pairs) to any Gutenberg block with active security, quick presets, and native rendering."
msgstr "Añade fácilmente atributos HTML personalizados (data-*, aria-*, booleanos y pares clave-valor) a cualquier bloque de Gutenberg con seguridad activa, presets rápidos y renderizado nativo."

#: build/index.js:1
#: src/index.js:143
msgid "Custom HTML Attributes"
msgstr "Atributos HTML Personalizados"

#: build/index.js:1
#: src/index.js:144
msgid "Add custom HTML attributes (data-*, aria-*, download, etc.) directly to the opening tag of this block."
msgstr "Añade atributos HTML personalizados (data-*, aria-*, download, etc.) directamente en la etiqueta de apertura de este bloque."

#: build/index.js:1
#: src/index.js:151
msgid "Your user role does not have sufficient permissions to add or edit custom HTML attributes."
msgstr "Tu rol de usuario actual no dispone de permisos suficientes para añadir o editar atributos HTML personalizados."

#. translators: %s: Preset label
#: build/index.js:2
#: src/index.js:169
#, js-format
msgid "Use preset %s"
msgstr "Usar preset %s"

#: build/index.js:2
#: src/index.js:181
msgid "e.g. title, data-track..."
msgstr "Ej: title, data-track..."

#: build/index.js:2
#: src/utils/validation.js:71
msgid "For security reasons, \"on*\" event attributes are not allowed."
msgstr "Por motivos de seguridad, los atributos de evento \"on*\" no están permitidos."

#. translators: %s: Attribute name
#: build/index.js:3
#: src/utils/validation.js:85
#, js-format
msgid "The attribute \"%s\" is already natively managed by WordPress."
msgstr "El atributo \"%s\" ya está gestionado de forma nativa por WordPress."

#. translators: %s: Attribute name
#: build/index.js:4
#: src/utils/validation.js:101
#, js-format
msgid "The attribute \"%s\" is disallowed for security reasons."
msgstr "El atributo \"%s\" no está permitido por motivos de seguridad."

#. translators: %s: Attribute name
#: build/index.js:5
#: src/utils/validation.js:117
#, js-format
msgid "The attribute \"%s\" is already added to this block."
msgstr "El atributo \"%s\" ya está añadido a este bloque."

#: build/index.js:5
#: src/utils/validation.js:59
msgid "Invalid characters. Use only lowercase letters, numbers, hyphens, colons, or underscores."
msgstr "Caracteres no permitidos. Usa solo minúsculas, números, guiones, dos puntos o barras bajas."

#: build/index.js:5
#: src/utils/validation.js:50
msgid "Please enter an attribute name."
msgstr "Introduce el nombre del atributo."

#: build/index.js:5
#: src/index.js:190
msgid "Add"
msgstr "Añadir"

#: build/index.js:5
#: src/index.js:202
msgid "Boolean / empty attribute (no value)"
msgstr "Atributo simple / booleano (sin valor)"

#: build/index.js:5
#: src/index.js:206
msgid "For attributes that do not require a value, such as download, inert, etc."
msgstr "Para atributos que no llevan valor, como download, inert, etc."

#: build/index.js:5
#: src/index.js:224
msgid "Remove attribute"
msgstr "Eliminar atributo"

#: build/index.js:5
#: src/index.js:243
msgid "Boolean attribute (rendered without a value)"
msgstr "Atributo booleano (se renderiza sin valor)"

#. translators: %s: Attribute key
#: build/index.js:6
#: src/index.js:234
#, js-format
msgid "Value for %s"
msgstr "Valor de %s"

#: build/index.js:6
#: src/index.js:248
msgid "Boolean attribute (no value)"
msgstr "Atributo booleano (sin valor)"


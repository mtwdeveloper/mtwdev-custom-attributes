# Normalización de saltos de línea
* text=auto eol=lf
*.bat text eol=crlf
*.mo binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Excluir carpetas de desarrollo, tests y fuentes del ZIP de distribución / exportación
/src/ export-ignore
/tests/ export-ignore
/node_modules/ export-ignore
/.git/ export-ignore
/.github/ export-ignore
/.vscode/ export-ignore

# Excluir archivos de configuración de desarrollo del ZIP final
/.gitignore export-ignore
/.gitattributes export-ignore
/package.json export-ignore
/pnpm-lock.yaml export-ignore
/pnpm-workspace.yaml export-ignore
/CONTRIBUTING.md export-ignore
/CONTRIBUTING.es.md export-ignore
